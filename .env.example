# IP-SAKTI Sahayak — Environment Variables Template
# =====================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file to version control.
#
# cp .env.example .env

# ── Gemini API Key (REQUIRED) ──────────────────────────────────────────────
# Used for: RAG grounded generation, query expansion, multilingual translation.
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative key name (either works; GEMINI_API_KEY is checked first):
# GOOGLE_API_KEY=your_google_api_key_here

# ── Optional: HuggingFace Token ────────────────────────────────────────────
# Suppresses the "unauthenticated requests" warning from HF Hub.
# law-ai/InLegalBERT is publicly accessible without a token.
# Get your token at: https://huggingface.co/settings/tokens
# HF_TOKEN=your_hf_token_here

# ── Optional: Deployment ───────────────────────────────────────────────────
# Set these when deploying to HuggingFace Spaces or cloud platforms:
# PORT=8000
# HOST=0.0.0.0
